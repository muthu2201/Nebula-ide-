# Rust build output
/target
**/*.rs.bk

# Nebula per-project state and caches
.nebula/cache/
*.nebula-tmp-*

# Local secrets and licences — never committed
.env
.env.local
*.lic
*.pem
!docs/**/*.pem

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
*~

# Stress-test and benchmark output
# The committed stress report is the evidence that the editor works; only the
# generated fixture project it runs against is disposable.
/stress-results/fixture/
/target/criterion/
